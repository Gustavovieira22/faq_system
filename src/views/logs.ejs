<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Logs de alterações</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/app.css" rel="stylesheet">

    <style>
        /* Regras exclusivas da tela de logs (o restante vem de /css/app.css) */

        .logs-table td {
            vertical-align: middle;
        }

        .logs-table tbody td {
            background: var(--app-surface);
            border-color: #eef2f8;
            padding: .7rem .75rem;
        }

        .logs-table tbody tr:hover td {
            background: #f8fafc;
        }

        .log-usuario {
            font-weight: 600;
            line-height: 1.2;
        }

        .log-descricao {
            color: #33415c;
            font-size: .9rem;
            margin: 0;
            max-width: 460px;
            overflow-wrap: anywhere;
            white-space: normal;
        }

        .log-details-toggle {
            color: var(--app-brand);
            cursor: pointer;
            font-size: .85rem;
            font-weight: 600;
            user-select: none;
        }

        .log-details-toggle:hover {
            color: var(--app-brand-dark);
        }

        .log-diff {
            --bs-table-bg: transparent;
            border-color: var(--app-line);
            font-size: .82rem;
            margin: .65rem 0 0;
        }

        .log-diff th {
            color: var(--app-muted);
            font-size: .68rem;
            font-weight: 600;
            letter-spacing: .06em;
            padding: .4rem .5rem;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .log-diff td {
            border-color: #eef2f8;
            max-width: 360px;
            overflow-wrap: anywhere;
            padding: .45rem .5rem;
            vertical-align: top;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .log-diff .log-antes {
            color: #a13b4b;
        }

        .log-diff .log-depois {
            color: #1d6b45;
        }

        .log-dados {
            background: var(--app-surface-soft);
            border: 1px solid var(--app-line);
            border-radius: .6rem;
            color: #33415c;
            font-size: .78rem;
            margin: .65rem 0 0;
            max-height: 240px;
            overflow: auto;
            padding: .65rem .8rem;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .log-dados-titulo {
            color: var(--app-muted);
            font-size: .7rem;
            font-weight: 600;
            letter-spacing: .06em;
            margin: .65rem 0 0;
            text-transform: uppercase;
        }
    </style>
</head>
<body>

<main class="app-shell container-fluid py-4 px-3 px-lg-4">

    <header class="page-header mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <div class="page-eyebrow mb-1">
                    Administração do FAQ
                </div>

                <h1 class="page-title">
                    Logs de alterações
                </h1>

                <p class="page-subtitle mb-0 mt-2">
                    Acompanhe quem alterou cada pergunta, variável ou usuário e o momento exato da alteração.
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a href="/buscar/perguntas" class="btn btn-outline-light">
                    Voltar ao FAQ
                </a>

                <a href="/usuarios" class="btn btn-outline-light">
                    Usuários
                </a>

                <a href="/cadastrar/variavel" class="btn btn-outline-light">
                    Variáveis
                </a>

                <form method="post" action="/logout">
                    <button type="submit" class="btn btn-light fw-semibold">
                        Sair
                    </button>
                </form>
            </div>
        </div>
    </header>

    <% if (erro) { %>
        <div class="alert alert-danger d-flex align-items-start gap-2 border-0 shadow-sm mb-4" role="alert">
            <svg class="flex-shrink-0 mt-1" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14Zm0-1A6 6 0 1 0 8 2a6 6 0 0 0 0 12Zm0-9.5a.75.75 0 0 1 .75.75v4a.75.75 0 0 1-1.5 0v-4A.75.75 0 0 1 8 4.5Zm0 6.75a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8Z"/>
            </svg>

            <span><%= erro %></span>
        </div>
    <% } %>

    <div class="card mb-4">
        <div class="card-header">
            <h2 class="section-title">
                Filtrar registros
            </h2>

            <div class="text-muted small">
                Combine o usuário, o módulo, o tipo de ação e o período para localizar uma alteração.
            </div>
        </div>

        <div class="card-body">
            <form method="get" action="/logs">
                <div class="row g-3">
                    <div class="col-lg-6">
                        <label for="busca" class="form-label">Buscar no texto</label>
                        <input
                            type="text"
                            id="busca"
                            name="busca"
                            class="form-control"
                            value="<%= filtros.busca %>"
                            placeholder="Ex.: nome da pergunta, variável ou usuário"
                        >
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label for="usuario" class="form-label">Usuário</label>
                        <select id="usuario" name="usuario" class="form-select">
                            <option value="">Todos</option>
                            <% usuarios.forEach(usuarioLog => { %>
                                <option
                                    value="<%= usuarioLog.login %>"
                                    <%= filtros.usuario === usuarioLog.login ? 'selected' : '' %>
                                >
                                    <%= usuarioLog.nome %> (<%= usuarioLog.login %>)
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label for="entidade" class="form-label">Módulo</label>
                        <select id="entidade" name="entidade" class="form-select">
                            <option value="">Todos</option>
                            <% Object.entries(entidades).forEach(([valor, rotulo]) => { %>
                                <option
                                    value="<%= valor %>"
                                    <%= filtros.entidade === valor ? 'selected' : '' %>
                                >
                                    <%= rotulo %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-lg-3 col-md-4">
                        <label for="acao" class="form-label">Ação</label>
                        <select id="acao" name="acao" class="form-select">
                            <option value="">Todas</option>
                            <% Object.entries(acoes).forEach(([valor, rotulo]) => { %>
                                <option
                                    value="<%= valor %>"
                                    <%= filtros.acao === valor ? 'selected' : '' %>
                                >
                                    <%= rotulo %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="col-lg-3 col-md-4">
                        <label for="dataInicio" class="form-label">De</label>
                        <input
                            type="date"
                            id="dataInicio"
                            name="dataInicio"
                            class="form-control"
                            value="<%= filtros.dataInicio %>"
                        >
                    </div>

                    <div class="col-lg-3 col-md-4">
                        <label for="dataFim" class="form-label">Até</label>
                        <input
                            type="date"
                            id="dataFim"
                            name="dataFim"
                            class="form-control"
                            value="<%= filtros.dataFim %>"
                        >
                    </div>

                    <div class="col-lg-3 d-flex align-items-end justify-content-lg-end gap-2">
                        <a href="/logs" class="btn btn-outline-secondary">
                            Limpar
                        </a>

                        <button type="submit" class="btn btn-primary">
                            Filtrar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>


    <div class="card">
        <div class="card-header">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2">
                <div>
                    <h2 class="section-title">
                        Registros
                    </h2>

                    <div class="text-muted small">
                        Alterações mais recentes aparecem primeiro.
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <% if (possuiFiltros) { %>
                        <span class="badge rounded-pill text-bg-light border">
                            Filtros aplicados
                        </span>
                    <% } %>

                    <span class="badge rounded-pill counter-badge">
                        <%= total %> <%= total === 1 ? 'registro' : 'registros' %>
                    </span>
                </div>
            </div>
        </div>

        <div class="card-body">
            <% if (logs.length === 0) { %>
                <div class="empty-state">
                    <div class="fw-semibold mb-1">
                        Nenhuma alteração encontrada
                    </div>

                    <div class="small">
                        <% if (possuiFiltros) { %>
                            Ajuste os filtros para ampliar a busca.
                        <% } else { %>
                            As alterações feitas no FAQ aparecerão aqui.
                        <% } %>
                    </div>
                </div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle simple-table logs-table mb-0">
                        <thead>
                            <tr>
                                <th>Data e hora</th>
                                <th>Usuário</th>
                                <th>Ação</th>
                                <th>Módulo</th>
                                <th>O que foi alterado</th>
                                <th>Detalhes</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% logs.forEach(log => { %>
                                <tr>
                                    <td class="text-nowrap small">
                                        <%= log.dataHora %>
                                    </td>

                                    <td>
                                        <div class="log-usuario">
                                            <%= log.usuarioNome %>
                                        </div>

                                        <div class="text-muted small">
                                            <code><%= log.usuarioLogin %></code>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge text-bg-<%= log.acaoClasse %>">
                                            <%= log.acaoRotulo %>
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge rounded-pill counter-badge">
                                            <%= log.entidadeRotulo %>
                                        </span>

                                        <% if (log.registroId) { %>
                                            <div class="text-muted small mt-1">
                                                nº <%= log.registroId %>
                                            </div>
                                        <% } %>
                                    </td>


                                    <td>
                                        <p class="log-descricao mb-0">
                                            <%= log.descricao %>
                                        </p>
                                    </td>

                                    <td>
                                        <% if (log.detalhes.length === 0 && !log.dadosAnteriores && !log.dadosNovos) { %>
                                            <span class="text-muted small">
                                                &mdash;
                                            </span>
                                        <% } else { %>
                                            <details>
                                                <summary class="log-details-toggle">
                                                    Ver detalhes
                                                </summary>

                                                <% if (log.detalhes.length > 0) { %>
                                                    <div class="table-responsive">
                                                        <table class="table log-diff mb-0">
                                                            <thead>
                                                                <tr>
                                                                    <th>Campo</th>
                                                                    <th>Antes</th>
                                                                    <th>Depois</th>
                                                                </tr>
                                                            </thead>

                                                            <tbody>
                                                                <% log.detalhes.forEach(detalhe => { %>
                                                                    <tr>
                                                                        <td class="fw-semibold">
                                                                            <%= detalhe.campo %>
                                                                        </td>

                                                                        <td class="log-antes">
                                                                            <%= detalhe.antes || '—' %>
                                                                        </td>

                                                                        <td class="log-depois">
                                                                            <%= detalhe.depois || '—' %>
                                                                        </td>
                                                                    </tr>
                                                                <% }) %>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                <% } %>

                                                <% if (log.dadosAnteriores) { %>
                                                    <div class="log-dados-titulo">
                                                        Antes
                                                    </div>

                                                    <pre class="log-dados"><%= log.dadosAnteriores %></pre>
                                                <% } %>

                                                <% if (log.dadosNovos) { %>
                                                    <div class="log-dados-titulo">
                                                        Depois
                                                    </div>

                                                    <pre class="log-dados"><%= log.dadosNovos %></pre>
                                                <% } %>
                                            </details>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>


                <% if (totalPaginas > 1) { %>
                    <nav class="mt-3" aria-label="Paginação dos logs">
                        <ul class="pagination pagination-sm justify-content-center mb-0">
                            <li class="page-item <%= temPaginaAnterior ? '' : 'disabled' %>">
                                <a class="page-link" href="<%= urlPaginaAnterior %>">
                                    Anterior
                                </a>
                            </li>

                            <% paginas.forEach(pagina => { %>
                                <li class="page-item <%= pagina.ativa ? 'active' : '' %>">
                                    <a class="page-link" href="<%= pagina.url %>">
                                        <%= pagina.numero %>
                                    </a>
                                </li>
                            <% }) %>

                            <li class="page-item <%= temProximaPagina ? '' : 'disabled' %>">
                                <a class="page-link" href="<%= urlProximaPagina %>">
                                    Próxima
                                </a>
                            </li>
                        </ul>

                        <div class="text-muted small text-center mt-2">
                            Página <%= paginaAtual %> de <%= totalPaginas %> · <%= total %> <%= total === 1 ? 'registro' : 'registros' %>
                        </div>
                    </nav>
                <% } %>
            <% } %>
        </div>
    </div>

</main>

</body>
</html>

