<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FAQ - Busca</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <% if (isAdmin) { %>
        <link href="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.snow.css" rel="stylesheet">
    <% } %>
    <link href="/css/app.css" rel="stylesheet">

</head>
<body>

<div id="app" class="app-shell app-shell--narrow py-4 px-3 px-lg-4">

    <header class="page-header mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <div class="page-eyebrow mb-1">
                    Central de atendimento
                </div>

                <h1 class="page-title">
                    FAQ - Puc Goiás CAD
                </h1>

                <p class="page-subtitle mb-0 mt-2">
                    Encontre a resposta pronta, abra o item e copie o texto no formato do WhatsApp. As mais copiadas aparecem no topo.
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <% if (isAdmin) { %>
                    <a href="/usuarios" class="btn btn-outline-light">
                        Usuários
                    </a>

                    <a href="/cadastrar/variavel" class="btn btn-outline-light">
                        Variáveis
                    </a>

                    <a href="/logs" class="btn btn-outline-light">
                        Logs
                    </a>
                <% } %>

                <form method="post" action="/logout">
                    <button type="submit" class="btn btn-outline-light">
                        Sair
                    </button>
                </form>

                <% if (isAdmin) { %>
                    <button
                        type="button"
                        class="btn btn-light fw-semibold"
                        data-bs-toggle="modal"
                        data-bs-target="#modalCadastroPergunta"
                    >
                        Nova pergunta
                    </button>
                <% } %>
            </div>
        </div>
    </header>

    <div class="card mb-4">
        <div class="card-body">
            <div class="search-field">
                <svg
                    class="search-icon"
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 16 16"
                    fill="currentColor"
                    aria-hidden="true"
                >
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85Zm-5.242 1.156a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11Z"/>
                </svg>

                <input
                    type="text"
                    class="form-control form-control-lg"
                    v-model="busca"
                    placeholder="Digite o assunto..."
                    aria-label="Buscar pergunta"
                    autofocus
                >
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
                <span class="text-muted small">
                    {{ textoBusca }}
                </span>

                <span class="badge rounded-pill counter-badge">
                    {{ resumoPerguntas }}
                </span>
            </div>
        </div>
    </div>

    <div
        v-if="carregando"
        class="empty-state d-flex align-items-center justify-content-center gap-2"
    >
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>

        <span>Carregando perguntas...</span>
    </div>

    <div
        v-else-if="perguntasFiltradas.length === 0"
        class="empty-state"
    >
        <div class="fw-semibold mb-1">
            Nenhuma pergunta encontrada
        </div>

        <div class="small">
            Tente buscar por outro assunto ou cadastre uma nova pergunta.
        </div>
    </div>

    <div v-else class="accordion faq-accordion">
        <div
            v-for="pergunta in perguntasFiltradas"
            :key="pergunta.id"
            class="accordion-item"
        >
            <h2 class="accordion-header">
                <button
                    class="accordion-button collapsed"
                    type="button"
                    data-bs-toggle="collapse"
                    :data-bs-target="'#pergunta-' + pergunta.id"
                >
                    {{ pergunta.titulo }}
                </button>
            </h2>

            <div
                :id="'pergunta-' + pergunta.id"
                class="accordion-collapse collapse"
            >
                <div class="accordion-body">
                    <div class="d-flex flex-wrap justify-content-end gap-2 mb-3">
                        <% if (isAdmin) { %>
                            <button
                                type="button"
                                class="btn btn-sm btn-outline-primary"
                                @click="abrirModalEdicao(pergunta)"
                            >
                                Editar
                            </button>

                            <button
                                type="button"
                                class="btn btn-sm btn-outline-danger"
                                @click="excluirPergunta(pergunta)"
                                :disabled="excluindoId === pergunta.id"
                            >
                                {{ excluindoId === pergunta.id ? 'Excluindo...' : 'Excluir' }}
                            </button>
                        <% } %>

                        <button
                            type="button"
                            class="btn btn-sm d-inline-flex align-items-center gap-1"
                            :class="copiadoId === pergunta.id ? 'btn-success' : 'btn-outline-secondary'"
                            @click="copiarResposta(pergunta)"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="14"
                                height="14"
                                viewBox="0 0 16 16"
                                fill="currentColor"
                                aria-hidden="true"
                            >
                                <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1Z"/>
                                <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3Zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3Z"/>
                            </svg>

                            {{ copiadoId === pergunta.id ? 'Copiado!' : 'Copiar' }}
                        </button>
                    </div>

                    <div class="faq-resposta" v-html="pergunta.resposta"></div>
                </div>
            </div>
        </div>

    </div>

    <% if (isAdmin) { %>
    <div
        class="modal fade"
        id="modalEditarPergunta"
        tabindex="-1"
        aria-labelledby="modalEditarPerguntaLabel"
        aria-hidden="true"
    >
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="modalEditarPerguntaLabel">
                        Editar pergunta
                    </h2>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fechar"
                    ></button>
                </div>

                <div class="modal-body">
                    <form @submit.prevent="salvarEdicaoPergunta">
                        <div class="mb-3">
                            <label for="edit-titulo" class="form-label">
                                Título
                            </label>

                            <input
                                type="text"
                                id="edit-titulo"
                                class="form-control"
                                v-model="editForm.titulo"
                                required
                            >
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Resposta
                            </label>

                            <div class="editor-shell">
                                <div id="editor-edicao-resposta" style="min-height: 200px;"></div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button
                                type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal"
                            >
                                Cancelar
                            </button>

                            <button
                                type="submit"
                                class="btn btn-primary"
                                :disabled="salvandoEdicao"
                            >
                                {{ salvandoEdicao ? 'Salvando...' : 'Salvar alteração' }}
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>

    <div
        class="modal fade"
        id="modalCadastroPergunta"
        tabindex="-1"
        aria-labelledby="modalCadastroPerguntaLabel"
        aria-hidden="true"
    >
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="modalCadastroPerguntaLabel">
                        Cadastro de FAQ
                    </h2>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fechar"
                    ></button>
                </div>

                <div class="modal-body">
                    <form @submit.prevent="cadastrarPergunta">
                        <div class="mb-3">
                            <label for="titulo" class="form-label">
                                Título
                            </label>

                            <input
                                type="text"
                                id="titulo"
                                class="form-control"
                                v-model="form.titulo"
                                placeholder="Informe um título para sua pergunta"
                                required
                            >
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Resposta
                            </label>

                            <div class="editor-shell">
                                <div id="editor-resposta" style="min-height: 200px;"></div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a
                                target="_blank"
                                href="/cadastrar/variavel"
                                class="btn btn-outline-secondary"
                            >
                                Variáveis
                            </a>

                            <button
                                type="submit"
                                class="btn btn-primary"
                            >
                                Cadastrar pergunta
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
    <% } %>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
<% if (isAdmin) { %>
    <script src="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.js"></script>
<% } %>
<script>
    window.USUARIO_ADMIN = <%- JSON.stringify(isAdmin) %>;
</script>
<script src="/js/perguntas.js"></script>

</body>
</html>
