<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Variáveis</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>
<body class="bg-light">

<div id="app" class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">
                    Variáveis
                </h1>

                <a href="/buscar/perguntas" class="btn btn-outline-secondary">
                    Voltar ao FAQ
                </a>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">

                    <h1 class="h3 mb-4">
                        Cadastrar variável
                    </h1>

                    <form @submit.prevent="cadastrarVariavel">

                        <div class="mb-3">
                            <label for="nome" class="form-label">
                                Nome
                            </label>

                            <input
                                type="text"
                                id="nome"
                                class="form-control"
                                v-model="form.nome"
                                placeholder="Ex.: LINK_MATRICULA"
                                required
                            >
                        </div>

                        <div class="mb-3">
                            <label for="valor" class="form-label">
                                Valor
                            </label>

                            <input
                                type="text"
                                id="valor"
                                class="form-control"
                                v-model="form.valor"
                                placeholder="Ex.: https://exemplo.com/matricula"
                                required
                            >
                        </div>

                        <button
                            type="submit"
                            class="btn btn-primary"
                            :disabled="salvando"
                        >
                            {{ salvando ? 'Salvando...' : 'Cadastrar' }}
                        </button>

                    </form>

                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="h4 mb-4">
                        Variáveis cadastradas
                    </h2>

                    <div
                        v-if="carregando"
                        class="text-muted"
                    >
                        Carregando...
                    </div>

                    <div
                        v-else-if="variaveis.length === 0"
                        class="text-muted"
                    >
                        Nenhuma variável cadastrada.
                    </div>

                    <div
                        v-else
                        class="table-responsive"
                    >
                        <table class="table table-hover align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>Nome</th>
                                    <th>Valor</th>
                                    <th class="text-end">Ações</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr
                                    v-for="variavel in variaveis"
                                    :key="variavel.id"
                                >
                                    <td>
                                        <span style="color: #d63384;">{{ variavel.nome }}</span>
                                    </td>

                                    <td>
                                        {{ variavel.valor }}
                                    </td>

                                    <td class="text-end">
                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            @click="abrirModalEdicao(variavel)"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEditarVariavel"
                                        >
                                            Editar valor
                                        </button>
                                    </td>
                                </tr>
                            </tbody>

                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <div
        class="modal fade"
        id="modalEditarVariavel"
        tabindex="-1"
        aria-labelledby="modalEditarVariavelLabel"
        aria-hidden="true"
    >
        <div class="modal-dialog">
            <div class="modal-content">

                <form @submit.prevent="salvarEdicaoVariavel">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="modalEditarVariavelLabel">
                            Editar valor da variável
                        </h2>

                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Fechar"
                        ></button>
                    </div>

                    <div class="modal-body">

                        <div class="mb-3">
                            <label class="form-label">
                                Nome
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                v-model="editForm.nome"
                                readonly
                                disabled

                            >
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Valor
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                v-model="editForm.valor"
                                required
                            >
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button
                            type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal"
                        >
                            Cancelar
                        </button>

                        <button
                            type="submit"
                            class="btn btn-primary"
                        >
                            Salvar alteração
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script src="/js/cadastroVariaveis.js"></script>

</body>
</html>
