<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - FAQ</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/app.css" rel="stylesheet">
</head>
<body>

<main class="auth-shell">
    <div class="card auth-card">
        <div class="auth-header">
            <span class="brand-mark mb-3" aria-hidden="true">
                FAQ
            </span>

            <h1 class="auth-title">
                FAQ - Acesso
            </h1>

            <p class="auth-subtitle mb-0">
                Entre com seu login e senha para consultar as respostas.
            </p>
        </div>

        <div class="auth-body">
            <% if (erro) { %>
                <div class="alert alert-danger d-flex align-items-start gap-2 border-0 shadow-sm mb-4" role="alert">
                    <svg class="flex-shrink-0 mt-1" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14Zm0-1A6 6 0 1 0 8 2a6 6 0 0 0 0 12Zm0-9.5a.75.75 0 0 1 .75.75v4a.75.75 0 0 1-1.5 0v-4A.75.75 0 0 1 8 4.5Zm0 6.75a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8Z"/>
                    </svg>

                    <span><%= erro %></span>
                </div>
            <% } %>

            <form method="post" action="/login">
                <div class="mb-3">
                    <label for="login" class="form-label">Login</label>
                    <input
                        type="text"
                        id="login"
                        name="login"
                        class="form-control"
                        autocomplete="username"
                        required
                        autofocus
                    >
                </div>

                <div class="mb-4">
                    <label for="senha" class="form-label">Senha</label>
                    <input
                        type="password"
                        id="senha"
                        name="senha"
                        class="form-control"
                        autocomplete="current-password"
                        required
                    >
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100">
                    Entrar
                </button>
            </form>
        </div>

        <div class="auth-footer">
            Puc Goiás CAD · Central de respostas do FAQ
        </div>
    </div>
</main>

</body>
</html>
